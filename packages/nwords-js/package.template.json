{
  "name": "@y4le/nwords",
  "version": "0.1.0",
  "private": true,
  "description": "Rust-backed named-shape ID encoding for Node and browsers.",
  "license": "(MIT OR Apache-2.0) AND MIT AND CC-BY-4.0",
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=24.14.1 <25" },
  "exports": {
    "./variable/web": { "types": "./src/variable-wasm/web.d.ts", "import": "./src/variable-wasm/web.js" },
    "./variable/node": { "types": "./src/variable-wasm/node.d.ts", "import": "./src/variable-wasm/node.js" },
    "./variable/wasm": "./wasm/variable/nwords_js_variable_bg.wasm",
    "./wordsets/adjective": { "types": "./src/wordsets/adjective.d.ts", "import": "./src/wordsets/adjective.js" },
    "./wordsets/animal": { "types": "./src/wordsets/animal.d.ts", "import": "./src/wordsets/animal.js" },
    "./wordsets/color": { "types": "./src/wordsets/color.d.ts", "import": "./src/wordsets/color.js" },
    "./wordsets/object": { "types": "./src/wordsets/object.d.ts", "import": "./src/wordsets/object.js" },
    "./wordsets/descriptor": { "types": "./src/wordsets/descriptor.d.ts", "import": "./src/wordsets/descriptor.js" },
    "./wordsets/mood": { "types": "./src/wordsets/mood.d.ts", "import": "./src/wordsets/mood.js" },
    "./wordsets/material": { "types": "./src/wordsets/material.d.ts", "import": "./src/wordsets/material.js" },
    "./wordsets/shape": { "types": "./src/wordsets/shape.d.ts", "import": "./src/wordsets/shape.js" },
    "./wordsets/weather": { "types": "./src/wordsets/weather.d.ts", "import": "./src/wordsets/weather.js" },
    "./wordsets/plant": { "types": "./src/wordsets/plant.d.ts", "import": "./src/wordsets/plant.js" },
    "./wordsets/food": { "types": "./src/wordsets/food.d.ts", "import": "./src/wordsets/food.js" },
    "./wordsets/eff-long": { "types": "./src/wordsets/eff-long.d.ts", "import": "./src/wordsets/eff-long.js" },
    "./node": { "types": "./src/node.d.ts", "import": "./src/node.js" },
    "./web": { "types": "./src/web.d.ts", "import": "./src/web.js" },
    "./bip39/node": { "types": "./src/bip39/node.d.ts", "import": "./src/bip39/node.js" },
    "./bip39/web": { "types": "./src/bip39/web.d.ts", "import": "./src/bip39/web.js" },
    "./bip39/wasm": "./wasm/bip39/nwords_js_bip39_bg.wasm",
    "./wasm": "./wasm/nwords_js_bg.wasm"
  },
  "files": ["src/", "wasm/", "examples/", "notices/", "README.md", "NOTICE.md", "LICENSE-MIT", "LICENSE-APACHE", "build.json"]
}
